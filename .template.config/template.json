  "classifications": [
    "Web",
    "API",
    "Clean Architecture",
    "Enterprise"
  ],
  "identity": "EnterpriseAppArchitecture.Orders",
  "name": "Enterprise App Architecture - Clean Architecture Solution",
  "shortName": "eaa-solution",
  "description": "A Clean Architecture solution template with Domain, Application, Infrastructure, and API layers plus comprehensive test projects.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Orders",
  "preferNameDirectory": true,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "include": [
        "**/*",
        ".kiro/**"
      ],
      "exclude": [
        "frontend/**",
        "docker-compose.yml",
        ".kiro/specs/**",
        ".github/**",
        ".vscode/**",
        ".template.config/**",
        "**/bin/**",
        "**/obj/**",
        "**/node_modules/**",
        ".git/**"
      ],
      "modifiers": [
        {
          "exclude": [
            "src/Orders.Application/Interfaces/IOrderExporter.cs",
            "src/Orders.Infrastructure/Caching/**",
            "src/Orders.Infrastructure/Specifications/**",
            "src/Orders.Infrastructure/Migrations/**",
            "tests/Orders.Domain.Tests/OrderFaker.cs",
            "tests/Orders.Domain.Tests/PricingServiceTests.cs",
            "tests/Orders.Infrastructure.Tests/Messaging/**",
            "tests/Orders.Infrastructure.Tests/Outbox/**",
            "tests/Orders.Api.Tests/Validation/**",
            "tests/Orders.Api.Tests/Cors/**",
            "tests/Orders.Api.Tests/RateLimiting/**",
            "tests/Orders.Integration.Tests/PlaceOrderIntegrationTests.cs"
          ]
        }
      ]
    }
  ]
